c3.txt
r1.txt
remote.txt
commit.txt
c.txt
c5.txt
c6.txt
s5.txt
d.txt
peek-*.txt
probe-*.txt
verify-*.txt
check-*.txt
debug-*.txt
out.txt
h.txt
dump.txt
dom*.txt
css*.txt
mobile-shots/
lh-*/
chrome-debug-*/
chrome-emul-*/
chrome-dp-*/
chrome-*/

# C:\Users\Administrator\.mavis\workspace\box-beeaa-site
# 提交以下文件：
#   - src/                  ← 源代码
#   - scripts/              ← 生成脚本（不含产物）
#   - data/                 ← keywords.json (必需)
#   - public/               ← WebP 优化后的图
#   - wrangler.toml
#   - .github/workflows/    ← Actions
#   - .gitignore

# build artifacts & local-only (added 2026-08-11)
# dist/ 入库 (Pages build_command=exit 0 不重新生成, 必须 git 入库)
dist-b-en/
dist-b-zh/
dist-pages/
_local_scripts/
_audit_temp/


