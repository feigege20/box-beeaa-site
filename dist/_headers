# Cloudflare Pages _headers
# https://developers.cloudflare.com/pages/configuration/headers/

# Global security + performance headers
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  X-XSS-Protection: 1; mode=block
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  # CSP (relaxed — allow inline scripts for our generator + schema JSON-LD)
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://*.cloudflare.com; frame-ancestors 'self'; form-action 'self' mailto:; base-uri 'self'
  # Cache control for HTML
  Cache-Control: public, max-age=300, s-maxage=600, stale-while-revalidate=86400

# Static assets — long cache
/styles/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/images/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/favicon.svg
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/favicon.ico
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/*.webp
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/*.js
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# Sitemap + robots — short cache so search engines get fresh
/sitemap*.xml
  Cache-Control: public, max-age=300, s-maxage=600

/robots.txt
  Cache-Control: public, max-age=3600, s-maxage=7200

/llms*.txt
  Cache-Control: public, max-age=3600, s-maxage=7200

/rss.xml
  Cache-Control: public, max-age=3600, s-maxage=7200

# 404 page — short cache
/404.html
  Cache-Control: public, max-age=300, s-maxage=600
